<Window x:Class="WinReckApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinReck"
        Icon="pack://application:,,,/app.ico"
        Width="340" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, Roboto, sans-serif"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ScrollBar -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#333333" RadiusX="3" RadiusY="3" Width="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="false" Height="6">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Dark Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="9,6" Margin="1,1">
                            <TextBlock Text="{Binding}" Foreground="{TemplateBinding Foreground}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#222428"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#142634"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device ComboBox (Fully Custom Dark Pill - No System Blue) -->
        <Style x:Key="HeaderDeviceComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- Custom ToggleButton that forms the pill header -->
                            <ToggleButton x:Name="toggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="pillBorder" Background="#111111" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="13" Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           Foreground="#E0E0E0" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="arrow" Grid.Column="1" Text="▾" Foreground="#777777" VerticalAlignment="Center" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#555555"/>
                                                <Setter TargetName="pillBorder" Property="Background" Value="#181818"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="pillBorder" Property="Background" Value="#161616"/>
                                                <Setter TargetName="arrow" Property="Foreground" Value="#00E5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Custom Popup for Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" StaysOpen="False" Focusable="False">
                                <Border Background="#121214" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="8" Padding="3" MaxHeight="220" MinWidth="180" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.85"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill button -->
        <Style x:Key="PillButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="13" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter TargetName="border" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circle action button -->
        <Style x:Key="CircleActionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#272727"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="RootBorder" Background="#060606" CornerRadius="16" BorderBrush="#1E1E1E" BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="5" Opacity="0.92" Direction="270"/>
            </Border.Effect>

            <Grid>
                <!-- ======================== SPLASH SCREEN (matches image 2 exactly) ======================== -->
                <Grid x:Name="SplashGrid" Background="#000000" Panel.ZIndex="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- WinReck Logo Row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="17" Height="17" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,11,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="WinReck" FontSize="26" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tagline -->
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="240" TextWrapping="Wrap">
                            <Run Text="The Windows audio recorder" FontSize="13" Foreground="#888888"/>
                            <LineBreak/>
                            <Run Text="that doesn't suck." FontSize="13" Foreground="#888888"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Bottom GitHub link -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" Cursor="Hand" MouseLeftButtonDown="GitHubLink_Click" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#666666" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            <TextBlock Text="github.com/winreck" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ======================== MAIN APP UI ======================== -->
                <Grid x:Name="MainAppGrid" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Background="#0A0A0A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Ellipse Width="11" Height="11" Fill="#FFFFFF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock Text="WinReck" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎤" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbMicrophone" Style="{StaticResource HeaderDeviceComboStyle}" Width="178" ToolTip="Microphone" SelectionChanged="CmbMicrophone_SelectionChanged" Margin="0,0,14,0"/>
                            <TextBlock Text="🎧" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbHeadphones" Style="{StaticResource HeaderDeviceComboStyle}" Width="178" ToolTip="Output Device" SelectionChanged="CmbHeadphones_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Click="BtnMinimize_Click" Background="Transparent" BorderThickness="0" Foreground="#777777" Width="30" Height="30" Cursor="Hand">
                                <TextBlock Text="—" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Click="BtnMaximize_Click" Background="Transparent" BorderThickness="0" Foreground="#777777" Width="30" Height="30" Cursor="Hand">
                                <TextBlock Text="▢" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Width="30" Height="30" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="#191919"/>

                    <!-- MAIN 2-COLUMN LAYOUT -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: FOLDERS QUADRANT (TOP) + RECORDINGS QUADRANT (BOTTOM) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top-Left: Folders Box -->
                                <RowDefinition Height="*"/>    <!-- Bottom-Left: Recordings Box -->
                            </Grid.RowDefinitions>

                            <!-- TOP-LEFT: FOLDERS QUADRANT -->
                            <Border Grid.Row="0" BorderBrush="#191919" BorderThickness="0,0,1,1" Padding="20,16,18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header with Title & Expandable Search -->
                                        <RowDefinition Height="Auto"/> <!-- Horizontal Folder Cards -->
                                    </Grid.RowDefinitions>

                                    <!-- Folders Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Folders" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Button Content="Load" Style="{StaticResource PillButtonStyle}" Click="BtnLoadFolder_Click" Margin="10,0,0,0" ToolTip="Select different base folder" Padding="8,2" FontSize="10.5"/>
                                        </StackPanel>

                                        <!-- Expandable Folder Search Bar -->
                                        <Border x:Name="FolderSearchBorder" Grid.Column="1" Width="85" Height="24" Background="#101013" BorderBrush="#25252B" BorderThickness="1" CornerRadius="12" Padding="7,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🔍" FontSize="9" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Grid Grid.Column="1">
                                                    <TextBlock x:Name="TxtFolderSearchPlaceholder" Text="search" FontSize="10.5" Foreground="#505055" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <TextBox x:Name="TxtFolderSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="10.5" VerticalAlignment="Center" CaretBrush="#00E5FF"
                                                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="TxtFolderSearch_TextChanged"/>
                                                </Grid>
                                                <Button x:Name="BtnClearFolderSearch" Grid.Column="2" Click="BtnClearFolderSearch_Click" Background="Transparent" BorderThickness="0" Foreground="#777777" Cursor="Hand" Visibility="Collapsed" Width="14" Height="14" Padding="0">
                                                    <TextBlock Text="✕" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Folder Cards Container with Hidden Scrollbar + Row-by-Row Scroll -->
                                    <Grid Grid.Row="1">
                                        <ScrollViewer x:Name="FoldersScrollViewer"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="240"
                                                      Padding="0,2,0,4"
                                                      PreviewMouseWheel="FoldersScrollViewer_PreviewMouseWheel"
                                                      ScrollChanged="FoldersScrollViewer_ScrollChanged">
                                            <WrapPanel x:Name="FoldersWrapPanel" Orientation="Horizontal"/>
                                        </ScrollViewer>

                                        <!-- Small Scroll Indicator telling users they can scroll row by row -->
                                        <Border x:Name="FolderScrollIndicator" Background="#E6181820" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4" Visibility="Collapsed" Cursor="Hand" ToolTip="Click or use mouse wheel to scroll row by row" MouseLeftButtonDown="FolderScrollIndicator_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖱️" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtScrollIndicatorText" Text="scroll" FontSize="9.5" Foreground="#888899" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock x:Name="TxtScrollArrow" Text="▾" FontSize="10" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- BOTTOM-LEFT: RECORDINGS QUADRANT -->
                            <Border Grid.Row="1" BorderBrush="#191919" BorderThickness="0,0,1,0" Padding="20,16,18,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header with Title, Folder Subtitle & Expandable Search -->
                                        <RowDefinition Height="*"/>    <!-- Recordings List -->
                                    </Grid.RowDefinitions>

                                    <!-- Recordings Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Recordings" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRecordingsFolderSubtitle" Text="in Main" FontSize="12.5" Foreground="#777777" VerticalAlignment="Center" Margin="7,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            <Button x:Name="BtnToggleSelectMode" Content="Select" Style="{StaticResource PillButtonStyle}" Click="BtnToggleSelectMode_Click" Margin="10,0,4,0" Padding="8,2" FontSize="10.5"/>
                                            <Button x:Name="BtnSelectAll" Content="All" Style="{StaticResource PillButtonStyle}" Click="BtnSelectAll_Click" Visibility="Collapsed" Margin="0,0,4,0" Padding="8,2" FontSize="10.5"/>
                                            <Button x:Name="BtnDeleteBatch" Content="Del (0)" Style="{StaticResource PillButtonStyle}" Foreground="#FF4D4D" BorderBrush="#88E63946" Click="BtnDeleteBatch_Click" Visibility="Collapsed" Padding="8,2" FontSize="10.5"/>
                                        </StackPanel>

                                        <!-- Expandable Recording Search Bar -->
                                        <Border x:Name="RecordingSearchBorder" Grid.Column="1" Width="85" Height="24" Background="#101013" BorderBrush="#25252B" BorderThickness="1" CornerRadius="12" Padding="7,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🔍" FontSize="9" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Grid Grid.Column="1">
                                                    <TextBlock x:Name="TxtRecordingSearchPlaceholder" Text="search" FontSize="10.5" Foreground="#505055" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <TextBox x:Name="TxtRecordingSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="10.5" VerticalAlignment="Center" CaretBrush="#00E5FF"
                                                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="TxtRecordingSearch_TextChanged"/>
                                                </Grid>
                                                <Button x:Name="BtnClearRecordingSearch" Grid.Column="2" Click="BtnClearRecordingSearch_Click" Background="Transparent" BorderThickness="0" Foreground="#777777" Cursor="Hand" Visibility="Collapsed" Width="14" Height="14" Padding="0">
                                                    <TextBlock Text="✕" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Recordings List ScrollViewer -->
                                    <ScrollViewer x:Name="RecordingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="RecordingsStackPanel">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform x:Name="RecordingsTranslateTransform"/>
                                            </StackPanel.RenderTransform>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- RIGHT: Top Recorder + Bottom Player -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TOP-RIGHT: Live Recorder -->
                            <Border Grid.Row="0" BorderBrush="#191919" BorderThickness="0,0,0,1" Padding="22">
                                <Grid>
                                    <!-- Live Waveform Canvas (custom mirrored bars scaled across graph, seekable when paused/previewing) -->
                                    <Canvas x:Name="LiveWaveformCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,50" ClipToBounds="True" Cursor="Hand"
                                            SizeChanged="LiveWaveformCanvas_SizeChanged"
                                            MouseLeftButtonDown="LiveWaveformCanvas_Seek"
                                            MouseMove="LiveWaveformCanvas_DragSeek"
                                            MouseLeftButtonUp="LiveWaveformCanvas_SeekUp"/>

                                    <Grid VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnRecordAction" Click="BtnRecordAction_Click" Style="{StaticResource CircleActionButton}" Margin="0,0,10,0">
                                                <Grid>
                                                    <Ellipse x:Name="RecIconDot" Width="12" Height="12" Fill="#E63946"/>
                                                    <StackPanel x:Name="PauseIconBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#E63946" Margin="0,0,2,0"/>
                                                        <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#E63946"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <StackPanel x:Name="PausedActionControls" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button x:Name="BtnPreviewLive" Click="BtnPreviewLive_Click" Content="Play Preview" Style="{StaticResource PillButtonStyle}" Margin="0,0,7,0"/>
                                                <Button x:Name="BtnSaveRecording" Click="BtnSaveRecording_Click" Content="Save" Style="{StaticResource PillButtonStyle}" Margin="0,0,7,0"/>
                                                <Button x:Name="BtnClearRecording" Click="BtnClearRecording_Click" Content="Clear" Style="{StaticResource PillButtonStyle}" Margin="0,0,9,0" ToolTip="Discard recording and reset"/>

                                                <!-- Checkbox to save directly to selected folder -->
                                                <Border Background="#141418" BorderBrush="#252530" BorderThickness="1" CornerRadius="12" Padding="7,3" VerticalAlignment="Center" Cursor="Hand" ToolTip="When checked, clicking Save saves directly into the currently selected folder without asking" MouseLeftButtonDown="ToggleDirectSaveOption_Click">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="DirectSaveCheckBox" Width="13" Height="13" Background="#0C0C10" BorderBrush="#353545" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock x:Name="DirectSaveCheckMark" Text="✓" FontSize="9.5" Foreground="#00E5FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                        </Border>
                                                        <TextBlock Text="Save to selected folder" FontSize="10.5" Foreground="#A0A0B0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Ellipse x:Name="LiveRecIndicator" Width="7" Height="7" Fill="#555555" Margin="4,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRecStatus" Text="Ready" FontSize="12" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#E63946" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRecTime" Text="0:00" FontSize="17" Foreground="#FFFFFF" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- BOTTOM-RIGHT: Player with scrollable/seekable waveform -->
                            <Border Grid.Row="1" Padding="22">
                                <Grid>
                                    <!-- Waveform in a horizontal ScrollViewer for scroll-to-seek -->
                                    <ScrollViewer x:Name="WaveformScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  Margin="0,0,0,50"
                                                  SizeChanged="WaveformScrollViewer_SizeChanged"
                                                  PreviewMouseWheel="WaveformScrollViewer_PreviewMouseWheel">
                                        <Canvas x:Name="PlayWaveformCanvas" Height="150" Background="Transparent" ClipToBounds="True" Cursor="Hand"
                                                MouseLeftButtonDown="PlayWaveformCanvas_Seek"
                                                MouseMove="PlayWaveformCanvas_DragSeek"
                                                MouseLeftButtonUp="PlayWaveformCanvas_SeekUp"/>
                                    </ScrollViewer>

                                    <!-- Playback Controls -->
                                    <Grid VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnPlayToggle" Grid.Column="0" Click="BtnPlayToggle_Click" Style="{StaticResource CircleActionButton}" Margin="0,0,12,0">
                                            <Grid>
                                                <TextBlock x:Name="TxtPlayIcon" Text="▶" FontSize="12" Foreground="#00D4FF" Margin="2,0,0,0"/>
                                                <StackPanel x:Name="PlayPauseBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#00D4FF" Margin="0,0,2,0"/>
                                                    <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#00D4FF"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="PlayingDotIndicator" Width="7" Height="7" Fill="#555555" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPlayingTitle" Text="No audio loaded" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtPlayingDescription" Text="Select a recording to play" FontSize="11" Foreground="#666666" Margin="14,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#00D4FF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtPlayTime" Text="0:00" FontSize="17" Foreground="#FFFFFF" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- APP-THEMED MODAL (delete confirmations) -->
                <Grid x:Name="CustomModalOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="200">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="14" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtModalTitle" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtModalMessage" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource PillButtonStyle}" Margin="0,0,10,0" Click="BtnModalCancel_Click"/>
                                <Button Content="Confirm" Style="{StaticResource PillButtonStyle}" Click="BtnModalConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SAVE RECORDING FOLDER PICKER MODAL -->
                <Grid x:Name="SaveDestinationModalOverlay" Background="#D9000000" Visibility="Collapsed" Panel.ZIndex="210">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Background="#121216" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="14" Padding="22">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.95"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header -->
                            <TextBlock Text="Save Recording" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="Choose destination folder from the main folder or subfolders:" FontSize="12" Foreground="#888899" Margin="0,0,0,14"/>

                            <!-- Folder Selection Items (Quick Picker) -->
                            <Border Background="#0B0B0E" BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="8" MaxHeight="220" Padding="6" Margin="0,0,0,18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SaveDestinationsStackPanel"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Button Content="Cancel" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="BtnSaveModalCancel_Click"/>
                                <Button x:Name="BtnSaveModalConfirm" Content="Save to Selected" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="BtnSaveModalConfirm_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
